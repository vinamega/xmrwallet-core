{
  "name": "xmrwallet-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/server/src/index.js",
    "build": "tsc -p tsconfig.json && mkdir -p dist/server/src/migrations && cp src/migrations/*.sql dist/server/src/migrations/ && cp src/wallets/*.mjs dist/server/src/wallets/",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "express": "^4.21.2",
    "monero-ts": "^0.11.20",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "puppeteer": "^25.13.0"
  }
}
