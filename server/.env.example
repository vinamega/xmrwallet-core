# xmrwallet-server env (DEV EXAMPLE — placeholders only, never real secrets)
# Copy to server/.env and fill. Dev box uses stagenet + faucet seeds only.
# Prod env is entered manually by the human in the mwprod service shell.

# Postgres
DATABASE_URL=postgres://xmrwallet:CHANGE_ME@127.0.0.1:5432/xmrwallet_dev

# Master key wrapping all per-wallet data keys (base64, 32 bytes).
# Generate: openssl rand -base64 32
# Prod: entered manually in the mwprod service env.
MASTER_KEY_B64=CHANGE_ME_BASE64_32_BYTES

# Network: stagenet (dev, CI) | mainnet (prod only)
NETWORK=stagenet

# Monero daemon RPC (stagenet loopback in dev; prod mainnet pruned node)
DAEMON_URL=http://127.0.0.1:38081

# Wallet files dir (managed wallets); service-owned in dev and prod
WALLET_DIR=/srv/wallets/stagenet/managed

# HTTP
PORT=3000
HOST=127.0.0.1
# Set to the https origin in prod (cookie Secure flag derives from this)
APP_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false

# Engine: monerots | fake (fake for API smoke tests without a chain)
ENGINE=monerots

# Restore queue
RESTORE_CONCURRENCY=20
RESTORE_MAX_ATTEMPTS=3
RESTORE_POLL_MS=1000

# Wallet manager
MAX_OPEN_WALLETS=50
WATCH_REFRESH_MS=30000
CHAIN_LOCK_TIMEOUT_MS=5000

# Limits (day-one abuse caps)
MAX_WALLETS_PER_USER=5
MAX_QUEUED_RESTORES_PER_USER=3
REGISTER_RATE_PER_HOUR=5
WALLET_CREATE_RATE_PER_HOUR=10

# Session
SESSION_TTL_DAYS=7

# Log
LOG_LEVEL=info

# Site gate (dev): if set, requests must present ?key=<value> once
# (sets a cookie). Keeps bots/scanners off; not a security boundary.
# Generate: openssl rand -hex 12
ACCESS_KEY=

# Plugins: comma-separated module paths (empty = reference no-op only)
PLUGIN_PATHS=